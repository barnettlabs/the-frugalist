# Local development. Use a hostname or LAN IP rather than 127.0.0.1 - a phone or
# simulator needs an address that resolves from its own network, not the Mac's
# loopback. Port 8787 is the Hono API (it was 8001 when this was Laravel).
# API_URL=https://thefrugalist.io/api
API_URL=http://babyjaymac:8787/api

