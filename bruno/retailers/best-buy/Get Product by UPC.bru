meta {
  name: Get Product by UPC
  type: http
  seq: 2
}

get {
  url: {{bestbuy_base_url}}/v1/products(upc={{upc}})
  body: none
  auth: none
}

params:query {
  apiKey: {{bestbuy_api_key}}
  format: json
  show: sku,upc,name,modelNumber,manufacturer,condition,type,regularPrice,salePrice,onSale,clearance,dollarSavings,percentSavings,priceUpdateDate,active,orderable,inStoreAvailability,onlineAvailability,inStorePickup,homeDelivery,freeShipping,freeShippingEligible,quantityLimit,url,image,longDescription,shortDescription,color,customerReviewAverage,customerReviewCount
  pageSize: 1
}

vars:pre-request {
  upc: 848604047140
}

docs {
  # Get Best Buy Product by UPC

  Fetches product details from Best Buy using the product UPC (Universal Product Code).

  ## Finding the UPC

  The UPC is typically a 12-digit barcode number found on product packaging.

  ## Example UPCs

  - `848604047140` - iBUYPOWER Y40 Gaming Desktop

  ## Notes

  - UPC searches work best for products with standard retail packaging
  - Some products may not have UPC data in Best Buy's system

  ## Key Response Fields

  Same as SKU lookup - see "Get Product by SKU" for full field documentation.
}
