meta {
  name: Get Product by UPC
  type: http
  seq: 2
}

get {
  url: {{bestbuy_base_url}}/v1/products(upc={{upc}})
  body: none
  auth: none
}

params:query {
  apiKey: {{bestbuy_api_key}}
  format: json
  show: sku,name,salePrice,regularPrice,onSale,url,image,longDescription,modelNumber
  pageSize: 1
}

vars:pre-request {
  upc: 0887276707129
}

docs {
  # Get Best Buy Product by UPC

  Fetches product details from Best Buy using the product UPC (Universal Product Code).

  ## Finding the UPC

  The UPC is typically a 12-digit barcode number found on product packaging.

  ## Notes

  - UPC searches work best for products with standard retail packaging
  - Some products may not have UPC data in Best Buy's system

  ## Response Fields

  - `sku` - Product SKU
  - `name` - Product name
  - `salePrice` - Current sale price
  - `regularPrice` - Regular/retail price
  - `onSale` - Whether product is on sale
  - `url` - Product page URL
  - `image` - Product image URL
  - `longDescription` - Product description
  - `modelNumber` - Manufacturer model number
}
