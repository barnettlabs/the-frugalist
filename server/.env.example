# Server configuration. Copy to .env for local development.
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:8787
PORT=8787
LOG_LEVEL=debug

# Local Postgres and Valkey from `docker compose up -d`. These ports are
# deliberately non-default so they cannot collide with a host install - and so
# you cannot silently test against a different engine version than production.
DATABASE_URL=postgres://frugalist:frugalist@127.0.0.1:55432/frugalist
DATABASE_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:56379

CORS_ORIGINS=http://localhost:5173,http://thefrugalist.local:8001

# Must match Laravel's BCRYPT_ROUNDS so existing password hashes verify.
BCRYPT_ROUNDS=12
SESSION_SECRET=dev-only-secret-change-me-at-least-32-chars

MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=noreply@thefrugalist.io
MAIL_FROM_NAME=TheFrugalist
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
