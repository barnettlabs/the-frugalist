# Server configuration. Copy to .env for local development.
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:8787
PORT=8787
LOG_LEVEL=debug

# Local Postgres. `docker compose up -d` exposes 55432; a host install uses 5432.
DATABASE_URL=postgres://jasonbarnett@127.0.0.1:5432/frugalist
DATABASE_POOL_MAX=10

REDIS_URL=redis://127.0.0.1:6379

CORS_ORIGINS=http://localhost:5173,http://thefrugalist.local:8001

# Must match Laravel's BCRYPT_ROUNDS so existing password hashes verify.
BCRYPT_ROUNDS=12
SESSION_SECRET=dev-only-secret-change-me-at-least-32-chars

MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=noreply@thefrugalist.io
MAIL_FROM_NAME=TheFrugalist
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
