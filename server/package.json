{
  "name": "@frugalist/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull && node tools/move-schema.mjs && node tools/normalize-schema.mjs",
    "db:studio": "drizzle-kit studio",
    "check-all": "pnpm run type-check && pnpm run test"
  },
  "dependencies": {
    "@frugalist/contracts": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.18.3",
    "@node-rs/bcrypt": "^1.10.8",
    "@scalar/hono-api-reference": "^0.5.164",
    "better-auth": "^1.7.3",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "hono-pino": "^0.7.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
