{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "thefrugalist-web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write \"src/**/*.{ts,vue,js,json,css,scss,md}\" \"*.{ts,js,json,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,vue,js,json,css,scss,md}\" \"*.{ts,js,json,md}\"",
		"type-check": "vue-tsc --noEmit",
		"check-all": "pnpm run lint && pnpm run type-check && pnpm run format:check && pnpm run test:run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/forms": "^0.5.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.2.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitest/ui": "^4.1.11",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.4.11",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"eslint-plugin-vue": "^10.10.0",
		"happy-dom": "^20.11.2",
		"jsdom": "^30.0.1",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.1",
		"vite-svg-loader": "^5.1.1",
		"vitest": "^4.1.11",
		"vue-tsc": "^3.3.10"
	},
	"dependencies": {
		"@headlessui/vue": "^1.7.23",
		"@heroicons/vue": "^2.2.0",
		"@vee-validate/zod": "^4.15.1",
		"axios": "^1.19.0",
		"pinia": "^4.0.3",
		"vee-validate": "^4.15.1",
		"vue": "^3.5.41",
		"vue-router": "^5.2.0",
		"zod": "^3.25.76"
	}
}
