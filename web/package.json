{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "thefrugalist-web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write \"src/**/*.{ts,vue,js,json,css,scss,md}\" \"*.{ts,js,json,md}\"",
		"format:check": "prettier --check \"src/**/*.{ts,vue,js,json,css,scss,md}\" \"*.{ts,js,json,md}\"",
		"type-check": "vue-tsc --noEmit",
		"check-all": "pnpm run lint && pnpm run type-check && pnpm run format:check && pnpm run test:run"
	},
	"devDependencies": {
		"@tailwindcss/forms": "^0.5.3",
		"@tailwindcss/vite": "^4.0.0",
		"@eslint/js": "^9.28.0",
		"@types/node": "^24.0.14",
		"@typescript-eslint/eslint-plugin": "^8.34.0",
		"@typescript-eslint/parser": "^8.34.0",
		"@vitejs/plugin-vue": "^5.0.0",
		"@vitest/ui": "^3.2.4",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.5.0",
		"@vue/test-utils": "^2.4.6",
		"autoprefixer": "^10.4.12",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.4.1",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"eslint-plugin-vue": "^9.32.0",
		"happy-dom": "^18.0.1",
		"jsdom": "^26.1.0",
		"postcss": "^8.4.31",
		"prettier": "^3.3.3",
		"tailwindcss": "^3.2.1",
		"typescript": "^5.8.3",
		"vite": "^6.2.4",
		"vite-svg-loader": "^5.1.0",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.0.1"
	},
	"dependencies": {
		"@headlessui/vue": "^1.7.23",
		"@heroicons/vue": "^2.2.0",
		"@vee-validate/zod": "^4.15.1",
		"axios": "^1.8.2",
		"pinia": "^3.0.4",
		"vee-validate": "^4.15.1",
		"vue": "^3.4.0",
		"vue-router": "^4.6.4",
		"zod": "^3.25.76"
	}
}
